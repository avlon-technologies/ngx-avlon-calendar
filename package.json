{
  "name": "ngx-avlon-calendar-workspace",
  "version": "0.1.0",
  "description": "Workspace for ngx-avlon-calendar - an aesthetic, flexible Angular date picker built with Tailwind CSS.",
  "scripts": {
    "ng": "ng",
    "start": "ng serve demo",
    "build": "npm run build:lib && ng build demo",
    "build:lib": "ng build ngx-avlon-calendar",
    "watch": "ng build ngx-avlon-calendar --watch --configuration development",
    "test": "ng test ngx-avlon-calendar --no-watch",
    "format": "prettier --write \"projects/**/*.{ts,html,css,json,md}\"",
    "test:demo": "ng test demo --no-watch",
    "test:all": "npm run test && npm run test:demo",
    "pack:lib": "npm run build:lib && cd dist/ngx-avlon-calendar && npm pack",
    "publish:lib": "npm run build:lib && npm publish dist/ngx-avlon-calendar --access public",
    "verify": "npm run build:lib && npm run test:all && ng build demo",
    "test:watch": "ng test ngx-avlon-calendar",
    "styles": "node scripts/build-lib-css.mjs",
    "styles:check": "node scripts/build-lib-css.mjs && git diff --exit-code -- projects/ngx-avlon-calendar/src/lib/styles/av-styles.css",
    "prebuild:lib": "npm run styles",
    "pretest": "npm run styles",
    "prestart": "npm run styles"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/cdk": "^22.1.0",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.0",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "@tailwindcss/cli": "^4.3.0",
    "@tailwindcss/postcss": "^4.3.0",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.1.0",
    "postcss": "^8.5.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.0",
    "typescript": "~7.0.2",
    "vitest": "^4.0.8"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.1": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
